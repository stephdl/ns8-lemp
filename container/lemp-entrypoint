set -e

# A fresh volume gets the sample pages, an existing site is never touched
if [[ "$1" == "php-fpm" && -z "$(ls -A /app)" ]]; then
    cp /usr/local/share/lemp/index.php /usr/local/share/lemp/phpinfo.php /app/
    chown -R www-data:www-data /app
fi

# Cron jobs start with an empty environment. pam_env cuts values at "#", which a
# password may hold, so lemp-cron-shell loads the variables from a bash file instead.
if [[ "$1" == "cron" ]]; then
    install -m 0640 -g www-data /dev/null /etc/lemp/cron.env
    for var in $(compgen -e | grep -E '^(LEMP_|NS8_HOSTNAME$|MAIL_FROM$)'); do
        declare -p "${var}" >> /etc/lemp/cron.env
    done
    { echo "SHELL=/usr/local/bin/lemp-cron-shell"; cat /etc/lemp/crontab; } > /etc/cron.d/lemp
    chmod 0644 /etc/cron.d/lemp
    rm -f /run/lemp-cron.pipe
    mkfifo -m 0620 /run/lemp-cron.pipe
    chgrp www-data /run/lemp-cron.pipe
    # Opened read-write, so cat never sees an end of file between two jobs.
    # Restarted if it dies, otherwise every job blocks on opening the pipe.
    while :; do cat 0<> /run/lemp-cron.pipe; done &
fi

rm -f /etc/msmtprc
if [[ -n "${SMTP_ENABLED}" && -n "${SMTP_HOST}" ]]; then
    case "${SMTP_ENCRYPTION}" in
        tls) tls=on starttls=off ;;
        starttls) tls=on starttls=on ;;
        *) tls=off starttls=off ;;
    esac
    {
        echo "defaults"
        echo "domain ${NS8_HOSTNAME:-localhost}"
        echo "syslog off"
        echo "account default"
        echo "host ${SMTP_HOST}"
        echo "port ${SMTP_PORT}"
        echo "tls ${tls}"
        echo "tls_starttls ${starttls}"
        echo "tls_certcheck $([[ -n "${SMTP_TLSVERIFY}" ]] && echo on || echo off)"
        echo "from ${MAIL_FROM:-noreply@${NS8_HOSTNAME:-localhost}}"
        if [[ -n "${SMTP_USERNAME}" ]]; then
            echo "auth on"
            echo "user ${SMTP_USERNAME}"
            echo "password ${SMTP_PASSWORD}"
        else
            echo "auth off"
        fi
    } > /etc/msmtprc
    # mail() runs msmtp as www-data, which must read the file
    chown root:www-data /etc/msmtprc
    chmod 0640 /etc/msmtprc
fi
unset SMTP_PASSWORD SMTP_USERNAME

exec docker-php-entrypoint "$@"
