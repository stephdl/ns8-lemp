# SPDX-License-Identifier: GPL-3.0-or-later
#

# Write the nginx, PHP and MariaDB files from the module settings.
# New files are tested in throwaway containers first: a broken file never
# replaces a working one. The custom files are created once and never
# overwritten, they are loaded after the generated ones.

import os
import sys
import shutil
import subprocess
import agent

env = os.environ

# Generated file: (path in state/, content)
php_upload = env["PHP_UPLOAD_MAX_FILESIZE"]
max_execution_time = env["PHP_MAX_EXECUTION_TIME"]
document_root = "/app" + ("/" + env["DOCUMENT_ROOT"].strip("/") if env.get("DOCUMENT_ROOT", "").strip("/") else "")

php_ini = f"""; Generated by the module from its settings, do not edit: use 90-custom.ini
memory_limit = {env["PHP_MEMORY_LIMIT"]}
upload_max_filesize = {php_upload}
post_max_size = {php_upload}
max_execution_time = {max_execution_time}
date.timezone = {env["PHP_TIMEZONE"]}
sendmail_path = "/usr/bin/msmtp -t"
expose_php = Off
error_log = /proc/self/fd/2
"""

fpm_conf = f"""; Generated by the module from its settings, do not edit: use 90-custom.conf
[www]
listen = 127.0.0.1:9000
pm = dynamic
pm.max_children = {env["FPM_PM_MAX_CHILDREN"]}
pm.start_servers = 2
pm.min_spare_servers = 1
pm.max_spare_servers = 3
request_terminate_timeout = {int(max_execution_time) + 30}
catch_workers_output = yes
decorate_workers_output = no
; nginx already logs each request with the real client address
access.log = /dev/null
env[LEMP_DB_HOST] = $LEMP_DB_HOST
env[LEMP_DB_PORT] = $LEMP_DB_PORT
env[LEMP_DB_NAME] = $LEMP_DB_NAME
env[LEMP_DB_USER] = $LEMP_DB_USER
env[LEMP_DB_PASSWORD] = $LEMP_DB_PASSWORD
"""
# Expose the LDAP credentials only when a user domain is bound
if env.get("USER_DOMAIN"):
    for var in ("HOST", "PORT", "SCHEMA", "BASE", "USER", "PASS"):
        fpm_conf += f"env[LEMP_LDAP_{var}] = $LEMP_LDAP_{var}\n"

mariadb_cnf = f"""# Generated by the module from its settings, do not edit: use 90-custom.cnf
[mysqld]
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
innodb_buffer_pool_size = {env["MARIADB_INNODB_BUFFER_POOL_SIZE"]}
max_allowed_packet = 256M
"""

phpmyadmin_fpm = """; Generated by the module: phpMyAdmin shares the pod network with the site PHP-FPM
[global]
daemonize = no
[www]
listen = 127.0.0.1:9001
"""

fastcgi_common = """        include fastcgi_params;
        fastcgi_param HTTPS on;
        fastcgi_param SERVER_PORT 443;
        fastcgi_param REQUEST_SCHEME https;"""

if env["NGINX_PRESET"] == "wordpress":
    site_locations = """    location = /favicon.ico { log_not_found off; access_log off; }
    location = /robots.txt { try_files $uri /index.php$is_args$args; log_not_found off; access_log off; }
    location = /xmlrpc.php { deny all; }
    location ~* ^/wp-config\\.php$ { deny all; }
    # Uploaded files must never run as PHP
    location ~* ^/wp-content/uploads/.*\\.php$ { deny all; }
    location ~* \\.(?:css|js|gif|ico|jpe?g|png|svg|webp|woff2?)$ {
        try_files $uri =404;
        expires 30d;
        access_log off;
    }
    location / {
        try_files $uri $uri/ /index.php$is_args$args;
    }"""
else:
    site_locations = """    location / {
        try_files $uri $uri/ /index.php$is_args$args;
    }"""

phpmyadmin_locations = ""
if env["PHPMYADMIN_ENABLED"] == "True":
    phpmyadmin_locations = f"""
    location = /phpmyadmin {{ return 301 /phpmyadmin/; }}
    location ^~ /phpmyadmin/ {{
        alias /srv/phpmyadmin/;
        index index.php;
        location ~ ^/phpmyadmin/(libraries|setup|templates|vendor)/ {{ deny all; }}
        location ~ ^/phpmyadmin/(.+\\.php)$ {{
            alias /srv/phpmyadmin/$1;
            fastcgi_pass 127.0.0.1:9001;
{fastcgi_common}
            fastcgi_param SCRIPT_FILENAME /var/www/html/$1;
            fastcgi_read_timeout 600s;
        }}
    }}
"""

nginx_conf = f"""# Generated by the module from its settings, do not edit: add files to custom.d/
server {{
    listen 8080 default_server;
    server_name _;
    root {document_root};
    index index.php index.html index.htm;

    client_max_body_size {php_upload};
    absolute_redirect off;
    server_tokens off;

    # Only Traefik reaches the published port, trust its client address
    set_real_ip_from 10.0.2.0/24;
    set_real_ip_from 127.0.0.1;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    access_log /dev/stdout;
    error_log /dev/stderr warn;

    # Hidden files like .htaccess, .git or .env are never served
    location ~ /\\.(?!well-known/) {{ deny all; }}
{phpmyadmin_locations}
    include /etc/nginx/lemp-custom.d/*.conf;

{site_locations}

    location ~ \\.php(?:$|/) {{
        fastcgi_split_path_info ^(.+?\\.php)(/.*)$;
        try_files $fastcgi_script_name =404;
        fastcgi_pass 127.0.0.1:9000;
{fastcgi_common}
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        fastcgi_read_timeout {max_execution_time}s;
    }}
}}
"""

generated = {
    "php/php.d/50-ns8.ini": php_ini,
    "php/fpm.d/50-ns8.conf": fpm_conf,
    "mariadb/50-ns8.cnf": mariadb_cnf,
    "phpmyadmin/zz-docker.conf": phpmyadmin_fpm,
    "nginx/default.conf": nginx_conf,
}

custom = {
    "php/php.d/90-custom.ini": "; Custom PHP settings, loaded after the module ones. Kept by backup and updates.\n; Example: max_input_vars = 5000\n",
    "php/fpm.d/90-custom.conf": "; Custom PHP-FPM pool settings, loaded after the module ones. Kept by backup and updates.\n; Example:\n; [www]\n; pm.max_requests = 500\n",
    "mariadb/90-custom.cnf": "# Custom MariaDB settings, loaded after the module ones. Kept by backup and updates.\n# Example:\n# [mysqld]\n# max_connections = 300\n",
    "nginx/custom.d/90-custom.conf": "# Custom nginx directives, included in the server block. Kept by backup and updates.\n# Example:\n# location /private/ { deny all; }\n",
    "crontab": "# Cron jobs of the site, run in the cron-app container. Kept by backup and updates.\n# The user field is required, run PHP jobs as www-data. Example:\n# */5 * * * * www-data php /app/cron.php\n",
}

# The services read these files as their own users (mysql, www-data, nginx)
os.umask(0o022)
for path, content in custom.items():
    if not os.path.exists(path):
        os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
        with open(path, "w") as fp:
            fp.write(content)

# The staging tree holds the new generated files next to a copy of the custom ones
staging = "config-staging"
shutil.rmtree(staging, ignore_errors=True)
for top in ("php", "mariadb", "nginx", "phpmyadmin"):
    if os.path.isdir(top):
        shutil.copytree(top, os.path.join(staging, top))
for path, content in generated.items():
    os.makedirs(os.path.join(staging, os.path.dirname(path)), exist_ok=True)
    with open(os.path.join(staging, path), "w") as fp:
        fp.write(content)


def check(name, args):
    proc = subprocess.run(["podman", "run", "--rm", "--network=none", "--log-driver=none"] + args,
                          stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    output = proc.stdout.strip()
    # PHP reports bad ini lines as warnings and still exits 0
    if name == "PHP" and ("PHP Warning" in output or "PHP Parse error" in output or "syntax error" in output):
        proc.returncode = 1
    if proc.returncode != 0:
        print(agent.SD_ERR + f"{name} configuration test failed:\n{output}", file=sys.stderr)
        return False
    return True


sp = os.path.abspath(staging)
php_image = env["PHP_IMAGE"]
ok = all([
    check("nginx", [
        f"--volume={sp}/nginx/default.conf:/etc/nginx/conf.d/default.conf:ro,Z",
        f"--volume={sp}/nginx/custom.d:/etc/nginx/lemp-custom.d:ro,Z",
        "--entrypoint=nginx", env["NGINX_IMAGE"], "-t", "-q",
    ]),
    check("PHP-FPM", [
        f"--volume={sp}/php/php.d:/etc/lemp/php.d:ro,Z",
        f"--volume={sp}/php/fpm.d:/etc/lemp/fpm.d:ro,Z",
        "--entrypoint=php-fpm", php_image, "--test",
    ]),
    check("PHP", [
        f"--volume={sp}/php/php.d:/etc/lemp/php.d:ro,Z",
        "--entrypoint=php", php_image, "-r", "exit(0);",
    ]),
    check("MariaDB", [
        f"--volume={sp}/mariadb:/etc/mysql/conf.d:ro,Z",
        "--entrypoint=mariadbd", env["MARIADB_IMAGE"], "--help", "--verbose",
    ]),
])

if not ok:
    shutil.rmtree(staging, ignore_errors=True)
    sys.exit(1)

for path in generated:
    os.makedirs(os.path.dirname(path), exist_ok=True)
    os.replace(os.path.join(staging, path), path)
shutil.rmtree(staging, ignore_errors=True)
