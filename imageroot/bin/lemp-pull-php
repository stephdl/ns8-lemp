# Pull the PHP-FPM image of the selected PHP version

import os
import agent
import lemp

php_image = lemp.php_image(os.environ["IMAGE_URL"], os.environ["PHP_VERSION"])
agent.run_helper("podman-pull-missing", php_image).check_returncode()
agent.set_env("PHP_IMAGE", php_image)
