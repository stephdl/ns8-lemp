[Unit]
Description=Podman mariadb-app.service
BindsTo=lemp.service
After=lemp.service
Before=php-fpm-app.service phpmyadmin-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%S/state/environment
Restart=always
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/mariadb-app.pid %t/mariadb-app.ctr-id
ExecStart=/usr/bin/podman run --conmon-pidfile %t/mariadb-app.pid \
    --cidfile %t/mariadb-app.ctr-id --cgroups=no-conmon \
    --pod-id-file %t/lemp.pod-id --replace -d --name mariadb-app \
    --volume mariadb-data:/var/lib/mysql/:Z \
    --volume %S/state/mariadb:/etc/mysql/conf.d:ro,Z \
    --env-file=%S/state/secrets/mariadb.env \
    --env MARIADB_ROOT_HOST=localhost \
    --env MARIADB_AUTO_UPGRADE=1 \
    ${MARIADB_IMAGE}
ExecStartPost=/usr/bin/podman exec mariadb-app /bin/sh -c 'until healthcheck.sh --connect; do sleep 1; done'
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/mariadb-app.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/mariadb-app.ctr-id
SyslogIdentifier=%u
PIDFile=%t/mariadb-app.pid
Type=forking

[Install]
WantedBy=default.target
