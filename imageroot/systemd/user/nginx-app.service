[Unit]
Description=Podman nginx-app.service
BindsTo=lemp.service
After=lemp.service php-fpm-app.service phpmyadmin-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%S/state/environment
Restart=always
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/nginx-app.pid %t/nginx-app.ctr-id
ExecStart=/usr/bin/podman run --conmon-pidfile %t/nginx-app.pid \
    --cidfile %t/nginx-app.ctr-id --cgroups=no-conmon \
    --pod-id-file %t/lemp.pod-id --replace -d --name nginx-app \
    --volume app:/app:ro,z \
    --volume %S/state/nginx/default.conf:/etc/nginx/conf.d/default.conf:ro,Z \
    --volume %S/state/nginx/custom.d:/etc/nginx/lemp-custom.d:ro,Z \
    --mount type=image,source=${PHPMYADMIN_IMAGE},destination=/srv/phpmyadmin,subpath=/var/www/html \
    --env NGINX_ENTRYPOINT_QUIET_LOGS=1 \
    ${NGINX_IMAGE}
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/nginx-app.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/nginx-app.ctr-id
ExecReload=/usr/bin/podman kill -s HUP nginx-app
SyslogIdentifier=%u
PIDFile=%t/nginx-app.pid
Type=forking

[Install]
WantedBy=default.target
