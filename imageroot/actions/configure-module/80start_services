# Redirect any output to the journal (stderr)
exec 1>&2

systemctl --user enable lemp.service
# Restarting only the pod does not restart its containers: list them all
systemctl --user restart lemp.service mariadb-app.service php-fpm-app.service phpmyadmin-app.service nginx-app.service cron-app.service
