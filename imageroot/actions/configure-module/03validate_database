import os
import sys
import json
import agent

agent.set_weight(os.path.basename(__file__), 0)

data = json.load(sys.stdin)

# Renaming would leave the site data in the old database: refuse it
errors = []
for field, var in [("db_name", "DB_NAME"), ("db_user", "DB_USER")]:
    current = os.getenv(var, "")
    if current and data[field] != current:
        errors.append({"field": field, "parameter": field, "value": data[field], "error": field + "_cannot_change"})

if errors:
    agent.set_status("validation-failed")
    json.dump(errors, fp=sys.stdout)
    sys.exit(2)
