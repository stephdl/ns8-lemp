import os
import re
import sys
import json
import agent

agent.set_weight(os.path.basename(__file__), 0)

data = json.load(sys.stdin)


def is_strong(password):
    # Same rules as the NsPasswordInput strength meter in the UI
    return (len(password) >= 8
            and re.search(r"[a-z]", password)
            and re.search(r"[A-Z]", password)
            and re.search(r"[0-9]", password)
            and re.search(r"[^A-Za-z0-9]", password))


def is_pending(path, key):
    # A password saved by a failed run is applied at the next one
    try:
        with open(path) as fp:
            return any(line.startswith(key + "=") and len(line.strip()) > len(key) + 1 for line in fp)
    except FileNotFoundError:
        return False


errors = []
for field, flag, path, key in [
        ("db_password", "DB_PASSWORD_SET", "secrets/db.env", "LEMP_DB_PASSWORD"),
        ("admin_password", "ADMIN_PASSWORD_SET", "secrets/admin.env", "MARIADB_ADMIN_PASSWORD"),
    ]:
    password = data.get(field, "")
    if not password and os.getenv(flag) != "True" and not is_pending(path, key):
        errors.append({"field": field, "parameter": field, "value": "", "error": field + "_required"})
    elif password and not is_strong(password):
        errors.append({"field": field, "parameter": field, "value": "", "error": field + "_too_weak"})
    elif password and "\n" in password:
        errors.append({"field": field, "parameter": field, "value": "", "error": field + "_invalid"})

if errors:
    agent.set_status("validation-failed")
    json.dump(errors, fp=sys.stdout)
    sys.exit(2)
