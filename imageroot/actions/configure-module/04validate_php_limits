import os
import sys
import json
import agent
import lemp

agent.set_weight(os.path.basename(__file__), 0)

data = json.load(sys.stdin)

if not lemp.memory_fits_upload(data):
    agent.set_status("validation-failed")
    json.dump([{"field": "php_memory_limit", "parameter": "php_memory_limit",
                "value": data["php_memory_limit"], "error": "php_memory_limit_too_low"}], fp=sys.stdout)
    sys.exit(2)
