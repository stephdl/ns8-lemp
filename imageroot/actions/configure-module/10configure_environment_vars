import os
import sys
import json
import agent

data = json.load(sys.stdin)

agent.set_env("TRAEFIK_HOST", data["host"])
agent.set_env("TRAEFIK_LETS_ENCRYPT", data["lets_encrypt"])
agent.set_env("PHP_VERSION", data["php_version"])
agent.set_env("DOCUMENT_ROOT", data["document_root"].strip("/"))
agent.set_env("NGINX_PRESET", data["nginx_preset"])
agent.set_env("PHP_MEMORY_LIMIT", data["php_memory_limit"])
agent.set_env("PHP_UPLOAD_MAX_FILESIZE", data["php_upload_max_filesize"])
agent.set_env("PHP_MAX_EXECUTION_TIME", data["php_max_execution_time"])
agent.set_env("PHP_TIMEZONE", data["php_timezone"])
agent.set_env("FPM_PM_MAX_CHILDREN", data["fpm_pm_max_children"])
agent.set_env("MARIADB_INNODB_BUFFER_POOL_SIZE", data["mariadb_innodb_buffer_pool_size"])
agent.set_env("PHPMYADMIN_ENABLED", data["phpmyadmin_enabled"])
agent.set_env("DB_NAME", data["db_name"])
agent.set_env("DB_USER", data["db_user"])
agent.set_env("USER_DOMAIN", data["user_domain"])
# Empty keeps the sender on the current host name, see lemp-entrypoint
agent.set_env("MAIL_FROM", data["mail_from"])


def write_secret(path, key, value):
    fd = os.open(path + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as fp:
        fp.write(f"{key}={value}\n")
    os.replace(path + ".tmp", path)


# Written before MariaDB applies them: a failed run retries with the same value
if data.get("db_password"):
    write_secret("secrets/db.env", "LEMP_DB_PASSWORD", data["db_password"])
if data.get("admin_password"):
    write_secret("secrets/admin.env", "MARIADB_ADMIN_PASSWORD", data["admin_password"])
