import os
import sys
import json
import agent
import lemp

data = json.load(sys.stdin)

for var, value in lemp.env_from_request(data).items():
    agent.set_env(var, value)
# Now computed from the node memory, see lemp-render-config
agent.unset_env("MARIADB_INNODB_BUFFER_POOL_SIZE")


def write_secret(path, key, value):
    fd = os.open(path + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as fp:
        fp.write(f"{key}={value}\n")
    os.replace(path + ".tmp", path)


# Written before MariaDB applies them: a failed run retries with the same value
if data.get("db_password"):
    write_secret("secrets/db.env", "LEMP_DB_PASSWORD", data["db_password"])
if data.get("admin_password"):
    write_secret("secrets/admin.env", "MARIADB_ADMIN_PASSWORD", data["admin_password"])
