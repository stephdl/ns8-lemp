import os
import sys
import json
import agent

data = json.load(sys.stdin)

agent.set_route({
    "instance": os.environ["MODULE_ID"],
    "url": "http://127.0.0.1:" + os.environ["TCP_PORT"],
    "host": data["host"],
    "http2https": True,
    "lets_encrypt": data["lets_encrypt"],
    "lets_encrypt_check": True,
    "lets_encrypt_cleanup": True,
})
agent.set_env("ROUTE_HOST", data["host"])
