set -e -o pipefail
exec 1>&2 # Redirect any output to the journal (stderr)

mkdir -vp initdb.d
mv -v lemp.sql initdb.d
# The MariaDB entrypoint sources this script after loading the dump: stop the temporary server and exit
cat - >initdb.d/zz_lemp_restore.sh <<'EOS'
mariadb --version
# The dump brings the healthcheck accounts of the source, with another password
# than .my-healthcheck.cnf written here: set them again to match the file
create_healthcheck_users | docker_process_sql --database=mysql
set -- true
docker_temp_server_stop
exit 0
EOS

trap 'rm -rfv initdb.d/' EXIT

# The dump holds the accounts too, the restored secrets match their passwords
podman run \
  --rm \
  --interactive \
  --network=none \
  --volume=./initdb.d:/docker-entrypoint-initdb.d:z \
  --volume mariadb-data:/var/lib/mysql/:z \
  --env-file=secrets/mariadb.env \
  --env MARIADB_ROOT_HOST=localhost \
  --replace --name=restore_db \
  ${MARIADB_IMAGE}
