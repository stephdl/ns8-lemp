import os
import secrets

# The root account stays internal to the module scripts, the admin gets the
# "admin" account and the site its own user, both set from the UI
os.makedirs("secrets", mode=0o700, exist_ok=True)
fd = os.open("secrets/mariadb.env", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w") as fp:
    fp.write(f"MARIADB_ROOT_PASSWORD={secrets.token_urlsafe(32)}\n")
for path in ("secrets/db.env", "secrets/admin.env"):
    os.close(os.open(path, os.O_WRONLY | os.O_CREAT, 0o600))
