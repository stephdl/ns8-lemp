set -e

# Redirect any output to the journal (stderr)
exec 1>&2

# Nothing to restart before the first configuration
if [[ -z "${PHP_VERSION}" ]]; then
    exit 0
fi

# The PHP-FPM image follows the module release, the files may get new settings
runagent lemp-pull-php
runagent lemp-render-config
systemctl --user try-restart lemp.service mariadb-app.service php-fpm-app.service phpmyadmin-app.service nginx-app.service cron-app.service
runagent lemp-clean-php-images
