import os
import sys
import json
import agent

event = json.load(sys.stdin)

# "domain" is obsolete since core 3.16.0, newer events carry "domains"
user_domain = os.getenv("USER_DOMAIN")
if not user_domain or user_domain not in {event.get("domain")} | set(event.get("domains", [])):
    sys.exit(0)

# A new bind password reaches PHP when its containers restart
agent.run_helper("systemctl", "--user", "try-restart", "php-fpm-app.service", "cron-app.service").check_returncode()
